<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_method_view_form_havoc_unbooked" model="ir.ui.view">
        <field name="name">pos.payment.method.form.havoc.unbooked</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='Payment methods']" position="after">
                <group name="havoc_booking" string="Verbuchung">
                    <field name="havoc_skip_accounting"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not havoc_skip_accounting">
                    <strong>Nicht verbuchen ist aktiv.</strong>
                    Bestellungen, die vollständig mit dieser Zahlart bezahlt werden, bekommen einen
                    normalen Bon, werden beim Abschluss der Kassensitzung aber <strong>nicht</strong>
                    in die Buchhaltung übernommen (kein Umsatz, keine USt, kein Zahlungseingang).
                    Sie können nicht fakturiert und nicht mit anderen Zahlarten kombiniert werden.
                    Zum normalen Verbuchen den Schalter deaktivieren. Änderungen sind nur möglich,
                    solange keine Kassensitzung mit dieser Zahlart geöffnet ist, und gelten für alle
                    danach eröffneten Sitzungen.
                </div>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_method_view_tree_havoc_unbooked" model="ir.ui.view">
        <field name="name">pos.payment.method.list.havoc.unbooked</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="havoc_skip_accounting" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
