<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- One-Pager: Banner → Headline → Tickets → Infos → Footer.
     Wird vom Controller auf `/` mit dem nächsten veröffentlichten Event gerendert. -->
<template id="homepage" name="Havoc One-Pager">
    <t t-call="website.layout">
        <div id="wrap" class="o_wevent_event js_event th_onepager d-flex flex-column">

            <!-- 1. HERO / Banner: fixes Bild aus dem Modul (im Website-Editor austauschbar) -->
            <section class="th_hero">
                <div class="oe_structure" id="oe_structure_theme_havoc_banner">
                    <img src="/theme_havoc/static/src/img/banner.jpg" class="th_hero_img" alt="HAVOC Classic Colosseum – 23.01.2027 – Dom im Berg Graz"/>
                </div>
            </section>

            <!-- Headline nur für SEO/Screenreader — das Banner-Bild trägt den Text -->
            <h1 t-out="event.name" class="visually-hidden"/>

            <!-- 2. Welcome-Block (im Website-Editor bearbeitbar) -->
            <section class="th_welcome text-center py-5">
                <div class="oe_structure" id="oe_structure_theme_havoc_welcome">
                    <div class="container">
                        <h2 class="th_welcome_title mb-4">Welcome to the Classic Colosseum</h2>
                        <p class="th_welcome_text mx-auto mb-5">
                            HAVOC geht in die Arena: Eine Nacht lang wird der Dom im Berg zum Colosseum.<br/>
                            Hardstyle- und Hardcore-Classics von 21:00 bis 06:00 Uhr, tief im Grazer Schloßberg,
                            mit unserer HAVOC Crew und Gästen.
                        </p>
                        <div class="th_hero_meta text-white mb-5">
                            <i class="fa fa-calendar me-2" role="img" aria-label="Datum"/>
                            <t t-set="th_one_night" t-value="(event.date_end - event.date_begin).total_seconds() &lt; 86400"/>
                            <t t-if="th_one_night">
                                <t t-out="event.date_begin" t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'dd.MM.yyyy'}"/>
                                &#8226; <t t-out="event.date_begin" t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'HH:mm'}"/>
                                &#8211; <t t-out="event.date_end" t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'HH:mm'}"/> Uhr
                            </t>
                            <t t-else="">
                                <t t-out="event.date_begin" t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'dd.MM.'}"/>
                                &#8211; <t t-out="event.date_end" t-options="{'widget': 'datetime', 'tz_name': event.date_tz, 'format': 'dd.MM.yyyy'}"/>
                            </t>
                        </div>
                        <div class="row justify-content-center g-4">
                            <div class="col-12 col-md-7">
                                <div class="th_day_card p-4 h-100">
                                    <h3 class="h4 mb-2">Samstag, 23.01.2027 :: HAVOC Crew + Gäste</h3>
                                    <p class="th_day_genre mb-1">Hardstyle &amp; Hardcore Classics</p>
                                    <p class="th_day_time mb-0">21:00 &#8211; 06:00 Uhr &#8226; Dom im Berg</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 3. Tickettypen -->
            <section id="tickets" class="th_tickets py-5">
                <div class="container">
                    <h2 class="text-center mb-5">Tickets</h2>
                    <t t-set="tickets" t-value="event.event_ticket_ids.filtered(lambda t: not t.is_expired)"/>
                    <!-- Hinweis über den Ticketkarten -->
                    <div class="text-center">
                        <div class="oe_structure" id="oe_structure_theme_havoc_ticket_note">
                            <p class="th_ticket_note mx-auto mb-5">
                                <strong>Die Tickets sind stark limitiert &#8211; der Dom im Berg hat nur eine Arena!</strong><br/>
                                Sichere dir dein Ticket so schnell wie möglich:
                                Ausverkauft ist ausverkauft.
                            </p>
                        </div>
                    </div>
                    <div t-if="tickets" class="row justify-content-center g-4 mb-4">
                        <div t-foreach="tickets" t-as="ticket" class="col-12 col-md-6 col-lg-4">
                            <!-- Karte anklicken öffnet das Ticket-Popup (Mengenauswahl) -->
                            <div class="th_ticket_card h-100 d-flex flex-column p-4"
                                t-att-role="event.event_registrations_open and 'button' or None"
                                t-att-data-bs-toggle="event.event_registrations_open and 'modal' or None"
                                t-attf-data-bs-target="#modal_{{'slot' if event.is_multi_slots else 'ticket'}}_registration">
                                <h3 t-field="ticket.name" class="h4"/>
                                <div class="th_ticket_price my-3">
                                    <t t-if="ticket.price">
                                        <span t-out="ticket.price" t-options="{'widget': 'monetary', 'display_currency': ticket.currency_id}"/>
                                    </t>
                                    <t t-else="">Gratis</t>
                                </div>
                                <p t-if="ticket.description" t-field="ticket.description" class="text-muted small flex-grow-1"/>
                                <div t-else="" class="flex-grow-1"/>
                                <div t-if="ticket.seats_limited and not ticket.seats_available" class="alert alert-danger py-1 small mb-0 mt-3">
                                    Ausverkauft
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Statusmeldung (Ausverkauft / Verkauf startet am …), falls Verkauf zu -->
                    <div class="text-center">
                        <t t-if="not event.event_registrations_open" t-call="website_event.registration_template"/>
                    </div>
                </div>
            </section>

            <!-- 4. Location (im Website-Editor bearbeitbar) -->
            <section class="th_infos text-center py-5">
                <div class="oe_structure" id="oe_structure_theme_havoc_location">
                    <div class="container">
                        <h2 class="mb-4">Location</h2>
                        <p class="th_location_name mb-1">Dom im Berg</p>
                        <p class="th_location_addr mb-4">Schloßbergplatz 1 &#8226; 8010 Graz</p>
                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Dom+im+Berg+Schlo%C3%9Fbergplatz+1+Graz" target="_blank" rel="noopener" class="btn btn-primary px-5">
                            <i class="fa fa-map-marker me-2" role="img" aria-label="Karte"/>Route planen
                        </a>
                    </div>
                </div>
            </section>

            <!-- Ablagefläche für weitere Blöcke aus dem Website-Editor -->
            <div class="oe_structure oe_empty" id="oe_structure_theme_havoc_home_1"/>
        </div>

        <!-- Standard-Odoo-Registrierungsmodal, damit der Ticketkauf hier direkt funktioniert -->
        <t t-if="event.is_multi_slots" t-call="website_event.modal_slot_registration"/>
        <t t-else="" t-call="website_event.modal_ticket_registration"/>
    </t>
</template>

</odoo>
