    <!-- Super Deal: Hoodie kaufen und ein Accessoire gratis dazu.
         Als Combo-Produkt: der Kassier wählt beim Antippen das Accessoire aus,
         Gesamtpreis bleibt 75 €. -->
    <record id="combo_hoodie" model="product.combo">
        <field name="name">Hoodie</field>
        <field name="sequence">1</field>
        <field name="combo_item_ids" eval="[(0, 0, {'product_id': ref('product_hoodie')})]"/>
    </record>
    <record id="combo_gratis_accessoire" model="product.combo">
        <field name="name">Gratis-Accessoire nach Wahl</field>
        <field name="sequence">2</field>
        <field name="combo_item_ids" eval="[
            (0, 0, {'product_id': ref('product_faecher')}),
            (0, 0, {'product_id': ref('product_schluesselanhaenger')}),
            (0, 0, {'product_id': ref('product_fahne')}),
            (0, 0, {'product_id': ref('product_beutel')}),
        ]"/>
    </record>
    <record id="product_hoodie_superdeal" model="product.product">
        <field name="name">Super Deal: Hoodie + Gratis-Accessoire</field>
        <field name="type">combo</field>
        <field name="combo_ids" eval="[(6, 0, [ref('combo_hoodie'), ref('combo_gratis_accessoire')])]"/>
        <field name="list_price">75.00</field>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_categ_merchandise')])]"/>
