<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="event_question_view_form_havoc_tickets" model="ir.ui.view">
        <field name="name">event.question.form.havoc.tickets</field>
        <field name="model">event.question</field>
        <field name="inherit_id" ref="event.event_question_view_form"/>
        <field name="arch" type="xml">
            <field name="once_per_order" position="after">
                <field name="havoc_event_ticket_ids" widget="many2many_tags"
                       invisible="once_per_order"
                       domain="[('event_id', 'in', event_ids)]"
                       options="{'no_create': True}"/>
                <field name="event_ids" invisible="1"/>
            </field>
        </field>
    </record>

</odoo>
