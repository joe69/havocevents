<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Teilnehmerformular: Fragen mit "Nur für Tickets" nur bei diesen Tickets anzeigen -->
    <template id="registration_attendee_details_havoc_ticket_questions" inherit_id="website_event.registration_attendee_details">
        <xpath expr="//t[@t-foreach='event.specific_question_ids']" position="attributes">
            <attribute name="t-foreach">event.specific_question_ids.filtered(lambda q: not q.havoc_event_ticket_ids or int(ticket['id']) in q.havoc_event_ticket_ids.ids)</attribute>
        </xpath>
    </template>

    <!-- Ticket-Popup: Phasen, die noch auf die vorherige warten, nicht als "Sold Out" zeigen, sondern ausblenden -->
    <template id="modal_ticket_registration_havoc_phases" inherit_id="website_event.modal_ticket_registration">
        <xpath expr="//form[@id='registration_form']//t[@t-set='tickets']" position="attributes">
            <attribute name="t-value">event.event_ticket_ids.filtered(lambda ticket: not ticket.is_expired and not ticket.havoc_phase_waiting)</attribute>
        </xpath>
    </template>

</odoo>
