<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Zusatzpaket (z. B. VIP-Package) direkt in der Ticketliste des Events wählbar -->
    <record id="event_event_ticket_view_tree_from_event_havoc_package" model="ir.ui.view">
        <field name="name">event.event.ticket.list.from.event.havoc.package</field>
        <field name="model">event.event.ticket</field>
        <field name="inherit_id" ref="event_product.event_event_ticket_view_tree_from_event"/>
        <field name="arch" type="xml">
            <field name="price" position="after">
                <field name="havoc_package_product_id" optional="show"
                       context="{'default_type': 'service', 'default_is_published': False}"/>
                <field name="havoc_previous_phase_id" optional="show" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="event_event_ticket_view_form_from_event_havoc_package" model="ir.ui.view">
        <field name="name">event.event.ticket.form.from.event.havoc.package</field>
        <field name="model">event.event.ticket</field>
        <field name="inherit_id" ref="event_product.event_event_ticket_view_form_from_event"/>
        <field name="arch" type="xml">
            <field name="price" position="after">
                <field name="havoc_package_product_id"
                       context="{'default_type': 'service', 'default_is_published': False}"/>
                <field name="havoc_previous_phase_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

</odoo>
